# ---- Server ----
PORT=4000
CORS_ORIGIN=http://localhost:5173

# ---- Mode ----
# DEMO_MODE=true simulates live-ticking data with no Meta credentials required.
# Set to false once you have a Meta access token + ad account IDs.
DEMO_MODE=true

# ---- Meta Marketing API ----
# System User or long-lived User access token with ads_read (+ ads_management if you
# also want status/budget changes later). Generate via business.facebook.com > System Users,
# or via the Graph API Explorer for testing.
META_ACCESS_TOKEN=

# Comma-separated ad account IDs, WITHOUT the "act_" prefix, e.g. 123456789,987654321
META_AD_ACCOUNT_IDS=

# Graph API version
META_GRAPH_VERSION=v21.0

# How often (ms) to poll the Graph API for campaigns/ads/insights.
# Meta rate-limits and attribution windows mean sub-minute polling is not meaningful
# for insights — 3-5 minutes is a sensible floor. Leads can arrive instantly via webhook
# (see META_WEBHOOK_VERIFY_TOKEN below), independent of this interval.
POLL_INTERVAL_MS=300000

# ---- Meta Leadgen Webhook (optional, for instant lead capture) ----
# Set this to any string of your choosing, then register the same string + your
# public /webhooks/meta URL in Meta App Dashboard > Webhooks > Page > leadgen.
META_WEBHOOK_VERIFY_TOKEN=

# App secret, used to verify the X-Hub-Signature-256 header on incoming webhooks.
META_APP_SECRET=
